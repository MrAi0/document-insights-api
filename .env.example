# Copy to .env and adjust. Every value here is optional, the defaults are in app/config.py.
# docker-compose.yml sets MONGO_URL and REDIS_URL itself, so those two only matter
# when running the app outside of compose.

# --- logging ---
LOG_LEVEL=INFO
# JSON lines for log aggregation. Set to false for readable logs while developing.
LOG_JSON=true

# --- mongo ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=document_insights
# How long to wait for a Mongo server before giving up on a request
MONGO_TIMEOUT_MS=3000

# --- redis ---
REDIS_URL=redis://localhost:6379/0
# Kept short on purpose. When Redis is down we fall back to Mongo, and we want
# to get there quickly instead of hanging every request.
REDIS_TIMEOUT_SECONDS=0.5

# --- limits and caching ---
# Max documents a user can have queued or processing at once (429 beyond that)
MAX_ACTIVE_JOBS_PER_USER=3
# Slots older than this are dropped from the rate limiter in case a worker died
# without releasing them
ACTIVE_JOB_TTL_SECONDS=3600
# How long a summary stays in Redis. After that it's still found in Mongo (and put
# back in Redis), so identical content is never processed twice.
SUMMARY_CACHE_TTL_SECONDS=86400

# --- worker ---
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=4
# Idle workers sleep until the API announces a new document (or a retry is due).
# This is the longest they sleep anyway, in case a wake-up got lost.
WORKER_MAX_IDLE_SECONDS=30
# Only used while Redis is down: with no wake-ups, workers poll Mongo this often
WORKER_POLL_INTERVAL_SECONDS=1.0
# How long a worker owns a job before it's considered dead and the job is retried.
# Must be longer than PROCESSING_MAX_SECONDS.
JOB_LEASE_SECONDS=60
# Total tries per document, including the first one
MAX_ATTEMPTS=3
# Retry delay is RETRY_BACKOFF_SECONDS * 2^(attempt - 1), plus/minus 20% jitter
RETRY_BACKOFF_SECONDS=5

# --- simulated processing ---
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=30
# Chance that a single attempt fails
FAILURE_RATE=0.1

# --- docker compose only ---
# Host ports compose publishes. Change them if something else on your machine
# already uses the defaults. The app itself doesn't read these.
# API_PORT=8000
# MONGO_PORT=27017
# REDIS_PORT=6379
